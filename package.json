{
  "name": "certificate",
  "version": "1.0.0",
  "description": "Certificate generation and verification service, running on AWS Lambda and deployed with Terraform",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-dev-server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npx tsc",
    "build:lambda": "node scripts/build-lambda.js",
    "infra:init": "terraform -chdir=infra init",
    "infra:plan": "yarn build:lambda && terraform -chdir=infra plan",
    "infra:apply": "yarn build:lambda && terraform -chdir=infra apply",
    "infra:destroy": "terraform -chdir=infra destroy",
    "deploy": "yarn infra:apply",
    "test": "jest --config jest.unit.config.js",
    "test:unit": "jest --config jest.unit.config.js",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "jest --config jest.unit.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:api": "node scripts/run-api-tests.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "@sparticuz/chromium": "^143.0.4",
    "dayjs": "^1.11.23",
    "handlebars": "^4.7.9",
    "puppeteer-core": "^24.35.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "newman": "^6.2.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "jest/**/minimatch": "^3.1.4",
    "jest/**/brace-expansion": "^1.1.18",
    "jest/**/js-yaml": "^3.15.1",
    "eslint/**/flatted": "^3.4.2",
    "jest/**/@babel/core": "^7.29.6"
  }
}
